# Spoonacular API key (https://spoonacular.com/food-api/console#Dashboard).
# Set this in Vercel project env vars, and in a local .env for `vercel dev`.
# NEVER expose this to the app bundle — the app only talks to this backend.
# If unset, the backend serves built-in fixture recipes so the app still works in dev.
SPOONACULAR_API_KEY=

# ElevenLabs Speech-to-Text API key (https://elevenlabs.io/app/settings/api-keys).
# Powers voice search. If unset, /api/transcribe returns a canned transcript in dev.
ELEVENLABS_API_KEY=

# Optional: comma-separated allowed origins for CORS. Defaults to "*".
ALLOWED_ORIGINS=*
